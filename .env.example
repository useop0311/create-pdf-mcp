# Server Configuration
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# Storage Mode: "auto" (uses R2 if configured, else local), "r2", "local", or "both"
STORAGE_MODE=auto
LOCAL_STORAGE_DIR=./data/files
LOCAL_FILE_TTL_HOURS=24

# Cloudflare R2 Configuration (Optional when using local mode)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pdf-mcp
# Optional custom public domain (e.g., https://pdf.example.com). If omitted, S3 presigned URLs are generated.
R2_PUBLIC_DOMAIN=
R2_PRESIGNED_EXPIRY_SECONDS=604800
